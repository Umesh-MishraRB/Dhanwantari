PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/dhanwantari

# Auth.js - generate with:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Only needed in production (public URL of the app)
# AUTH_URL=https://your-domain.com/auth

# Google OAuth ("Continue with Google") - see GOOGLE_OAUTH_SETUP.md. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLIENT_URL=http://localhost:5173

# FastAPI ML service (see ml_service_patch/). Set ML_MOCK=true to run the app without it.
ML_API_URL=http://127.0.0.1:8000
ML_MOCK=false

# Optional: e-mail the published report to the patient. Leave empty to skip.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "report ready" e-mail attaches the report PDF (+ the handwritten file). Set false to send a link only.
MAIL_ATTACH_REPORT=true
MAIL_FROM="Dhanwantari <no-reply@yourdomain.com>"

# ---- production ----
# Reverse-proxy hops in front of Node (Render/Railway/Nginx = 1). Used for client IPs / rate limits.
# TRUST_PROXY=1
# Hide new doctors until you approve them:  npm run verify-doctor -- doctor@example.com
# REQUIRE_DOCTOR_APPROVAL=true
# Set to "off" only if the Content-Security-Policy blocks something you added.
# CSP=off
